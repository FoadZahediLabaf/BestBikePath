@startuml
title Manual Pause and Resume Trip Recording

actor "Authenticated User" as U
boundary "BBP App (UI)" as UI
control "Recording Controller" as RC
entity "Sensors/GPS" as S
database "DB" as DB

== Pause ==
U -> UI : Tap "Pause"
activate UI
UI -> RC : pauseRecording()
activate RC
RC -> S : stopAcquisition()
activate S
S --> RC : stopped
deactivate S
RC -> DB : persistState(Paused)
activate DB
DB --> RC : OK
deactivate DB
RC --> UI : showPausedUI()
deactivate RC
UI --> U : UI shows Paused + Resume button
deactivate UI

== Resume ==
U -> UI : Tap "Resume"
activate UI
UI -> RC : resumeRecording()
activate RC
RC -> S : startAcquisition()
activate S

alt GPS/Sensors available
  S --> RC : ready
  deactivate S
  RC -> DB : persistState(Recording)
  activate DB
  DB --> RC : OK
  deactivate DB
  RC --> UI : showRecordingUI()
  UI --> U : UI shows Recording
else GPS/Sensors unavailable
  S --> RC : error
  deactivate S
  RC --> UI : showError("GPS/Sensors unavailable")
  UI --> U : Stay Paused
end

deactivate RC
deactivate UI
@enduml
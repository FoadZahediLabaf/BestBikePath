classDiagram

  class User {
    id: int
    name: String
  }

  class Trip {
    origin: Location
    destination: Location
    tripId: int
    date: Date
    duration: int
    isPublishable: boolean
  }

  class TripStatistics {
    distance: double
    avgSpeed: double
    maxSpeed: double
    elevationGain: double
  }

  class WeatherData {
    condition: String
    temperature: double
    windSpeed: double
  }

  class TripSegment {
    localStatus: PathCondition
  }

  class Segment {
    segmentId: int
    streetName: String
  }

  class Obstacle {
    obstacleId: int
    type: String
    severity: int
  }

  class GlobalPathInfo {
    avgStatus: PathCondition
    reliability: double
    freshness: Date
  }

  class Recommendation {
    origin: Location
    destination: Location
  }

  class Path {
    pathId: int
    score: double
  }

  class DeviationEvent {
    timestamp: DateTime
    deviationDistance: double
  }

  class Location {
    latitude: double
    longitude: double
  }

  class PathCondition {
    optimal
    medium
    sufficient
    requiresMaintenance
  }



  User "1" --> "0..*" Trip : records
  Trip "1" --> "1" TripStatistics : has
  Trip "1" --> "0..1" WeatherData : enrichedBy
  Trip "1" --> "1..*" TripSegment : composedOf
  TripSegment "1" --> "1" Segment : refersTo
  TripSegment "1" --> "0..*" Obstacle : contains
  Segment "1" --> "0..*" GlobalPathInfo : aggregatedAs

  User "1" --> "0..*" Recommendation : requests
  Recommendation "1" --> "1..*" Path : includes
  Path "1" --> "1..*" Segment : consistsOf

  Trip "1" --> "0..*" DeviationEvent : generates
